{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões principais do KPassword",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "updater:default",
    "process:allow-restart",
    "core:window:allow-set-theme",
    "core:window:allow-theme",
    "allow-bridge-open",
    "allow-bridge-close",
    "allow-bridge-history",
    "allow-bridge-status",
    "allow-bridge-set-limits",
    "allow-bridge-revoke-grant",
    "allow-platform-name",
    "allow-clipboard-write-secret",
    "allow-clipboard-clear-secret",
    "allow-linux-capture-qr",
    "allow-hide-to-tray",
    "allow-set-tray-labels",
    "allow-vault-session-unlock",
    "allow-vault-session-encrypt",
    "allow-vault-session-verify-password",
    "allow-vault-session-decrypt",
    "allow-vault-session-close",
    "allow-get-startup-status",
    "allow-set-startup-enabled",
    "allow-load-vault-file",
    "allow-save-vault-file",
    "allow-restore-vault-file",
    "allow-get-storage-info",
    "allow-list-vault-files",
    "allow-delete-vault-file",
    "allow-list-backup-files",
    "allow-read-backup-file",
    "allow-create-pre-argon2-backup",
    "allow-reencrypt-backups",
    "allow-encrypt-vault-argon2id",
    "allow-decrypt-vault-payload",
    "allow-verify-backup-payload",
    "allow-open-vault-folder",
    "allow-open-backup-folder",
    "allow-open-external-url",
    "allow-windows-hello-status",
    "allow-enable-windows-hello",
    "allow-disable-windows-hello",
    "allow-unlock-with-windows-hello",
    "allow-discard-orphan-windows-hello",
    "allow-quarantine-windows-hello",
    "allow-decode-qr-from-image-data-url",
    "allow-get-windows-clipboard-sequence-number",
    "allow-start-windows-screen-snip",
    "allow-restore-main-window-after-screen-snip",
    "allow-read-windows-clipboard-image-png-data-url"
  ]
}
